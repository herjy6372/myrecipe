rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      // 클라이언트가 쓰는 필드만 허용하고, 각 값의 타입/크기를 검증해
      // 변조된 클라이언트가 임의 데이터를 문서에 채워 넣지 못하게 막는다.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['photoBase64', 'birthDate', 'phoneNumber'])
        && (!('photoBase64' in request.resource.data)
            || (request.resource.data.photoBase64 is string
                && request.resource.data.photoBase64.size() < 200000))
        && (!('birthDate' in request.resource.data)
            || request.resource.data.birthDate is timestamp)
        && (!('phoneNumber' in request.resource.data)
            || (request.resource.data.phoneNumber is string
                && request.resource.data.phoneNumber.size() < 30));

      match /favorites/{recipeId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;

        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'thumbnailUrl', 'addedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() < 300
          && request.resource.data.thumbnailUrl is string
          && request.resource.data.thumbnailUrl.size() < 500
          && request.resource.data.addedAt is timestamp;
      }
    }
  }
}
